	pages = {1--6},
	file = {PDF:C\:\\Users\\maydd\\Zotero\\storage\\AIKHPNCB\\Madusanka et al. - 2025 - UrbanGreen - E-Waste Detection and Analysis using YOLOv5.pdf:application/pdf},
